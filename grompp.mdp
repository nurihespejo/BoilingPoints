; prod.mdp --> Prod de 20 ns
integrator             = md
dt                     = 0.002
nsteps                 = 10000000 ; 20 ns

nstlog                 = 1000
nstenergy              = 1000
nstxout-compressed     = 10000

cutoff-scheme          = Verlet
coulombtype            = PME
rcoulomb               = 0.9
vdwtype                = Cut-off
vdw-modifier           = force-switch
rvdw                   = 0.9
rvdw-switch            = 0.8
DispCorr               = EnerPres

tcoupl                 = V-rescale
tc-grps                = System
tau-t                  = 1.0
ref-t                  = 300.00 
pcoupl                 = C-rescale
pcoupltype             = isotropic
tau-p                  = 2.0
compressibility        = 4.5e-5
ref-p                  = 1.0

;continuation           = yes 
constraints            = all-bonds 
constraint-algorithm   = LINCS
lincs-iter             = 6
gen_vel                = yes
gen_temp               = 300 
energygrps             = 1st 2nd
